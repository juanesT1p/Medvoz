# Configuración local: dejar mock para desarrollar sin enviar datos a un proveedor externo.
LLM_PROVIDER=mock
LLM_MODEL=mock
LLM_EXTRACT_MODEL=
LLM_EXPLAIN_MODEL=
LLM_TIMEOUT_MS=30000

# Proveedores LLM. No guardar claves reales en el repositorio.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

DATABASE_URL=postgresql://medvoz:medvoz@localhost:5432/medvoz?schema=public
TTS_PROVIDER=browser
TTS_API_KEY=
PORT=3001
CORS_ORIGIN=http://localhost:5173
MAX_IMAGE_MB=10
