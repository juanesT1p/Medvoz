generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Drug {
  id              String   @id @default(uuid())
  commercialName  String
  activeIngredient String
  normalizedName  String   @unique
  synonyms        String[]
  principioActivo String   @default("")
  nombresComunes  String[] @default([])
  queEs           String?
  paraQueSuele    String?
  comoActua      String?
  precauciones    String[] @default([])
  senalesDeAlerta String[] @default([])
  preguntasParaMedico String[] @default([])
  fuente          String?
  revisadoPor     String   @default("pendiente")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([activeIngredient])
}

model UsageEvent {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  phase     String
  success   Boolean
  latencyMs Int

  @@index([timestamp])
}
